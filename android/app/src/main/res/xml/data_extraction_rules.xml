<?xml version="1.0" encoding="utf-8"?>
<!-- Back up preferences (theme, settings); Room database caches are preserved on device transfer; token store excluded from cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="copypaste.db" />
    </device-transfer>
</data-extraction-rules>
